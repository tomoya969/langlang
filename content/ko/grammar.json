  {"id": "ko-g-L2-049", "level": 2, "form": "-(으)ㄹ까 하다", "ja": "〜しようかと思う", "example": "대기업에 취직할까 해요.", "unit": "L2-U28"},
  {"id": "ko-g-L2-050", "level": 2, "form": "-(으)ㄹ지도 모르다", "ja": "〜するかもしれない", "example": "이 회사가 나를 뽑을지도 몰라.", "unit": "L2-U28"},
